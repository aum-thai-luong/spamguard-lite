{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(./gradlew *install*)",
      "Bash(./gradlew *connected*)",
      "Bash(./gradlew *BaselineProfile*)",
      "Bash(git reset --hard:*)",
      "Read(./local.properties)",
      "Edit(./BUGS.md)"
    ],
    "deny": [
      "Read(./keystore.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/google-services.json)",
      "Edit(./core/data/schemas/**)",
      "Edit(./app/src/release/generated/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ]
  }
}

<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/callLogFragment">

    <fragment
        android:id="@+id/callLogFragment"
        android:name="com.spamguard.feature.calllog.CallLogFragment"
        android:label="@string/destination_call_log" />

    <!-- Mở bằng deep link nội bộ từ :feature:calllog (CallDetailNavigation.kt), vì feature không thấy R của app.
         Manifest không khai báo <nav-graph>, nên app khác không mở được URI này. -->
    <fragment
        android:id="@+id/callDetailFragment"
        android:name="com.spamguard.feature.calllog.detail.CallDetailFragment"
        android:label="@string/destination_call_detail">
        <argument
            android:name="callId"
            app:argType="long" />
        <deepLink app:uri="android-app://com.spamguard.lite/call-detail/{callId}" />
    </fragment>

    <fragment
        android:id="@+id/blocklistFragment"
        android:name="com.spamguard.feature.blocklist.BlocklistFragment"
        android:label="@string/destination_blocklist" />

</navigation>
